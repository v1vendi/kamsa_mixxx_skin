+            *it != queryCueMarkers(mixxx::DbConnectionPooled(m_pDbConnectionPool), trackId)) {
+        // Overviews of other sizes are cached while another one may be
+        // rendering: drop them all, a running render is discarded as well.
+        onTrackSummaryChanged(trackId);
+        return;
+    }
+    if (m_currentlyLoading.contains(trackId)) {
+        // Compare once the result arrived instead of discarding it right
+        // away: tracks are also reported clean when merely loaded, e.g. by
+        // CoverArtDelegate, which would re-render the overview for nothing.
+        m_cueCheckAfterLoading.insert(trackId);
+    }
