+bool WSpinnyBase::deckBeatsAt(double playpos, double* pResult) const {
+    if (!m_pLoadedTrack || util_isnan(playpos)) {
+        return false;
+    }
+    const mixxx::BeatsPointer pBeats = m_pLoadedTrack->getBeats();
+    if (!pBeats) {
+        return false;
+    }
+    const double trackFrames = m_pTrackSamples.get() / 2;
+    if (!(trackFrames > 0)) {
+        return false;
+    }
+    const auto firstBeat = pBeats->firstBeat();
+    if (!firstBeat.isValid()) {
+        return false;
+    }
+    const auto position = mixxx::audio::FramePos(playpos * trackFrames);
+    // The beatgrid starts on a downbeat, so beats counted from the first beat
+    // give the position in the bar.
+    auto nextIt = pBeats->iteratorFrom(position);
+    // cbegin() cannot be decremented (int underflow)
+    if (nextIt == pBeats->cbegin()) {
+        return false;
+    }
+    auto prevIt = nextIt;
+    --prevIt;
+    const mixxx::audio::FramePos next = *nextIt;
+    const mixxx::audio::FramePos prev = *prevIt;
+    const double length = next - prev;
+    if (!(length > 0)) {
+        return false;
+    }
+    const int index = nextIt - pBeats->iteratorFrom(firstBeat);
+    *pResult = index - 1 + (position - prev) / length;
+    return true;
+}
