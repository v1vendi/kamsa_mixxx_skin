+// The cover art label (or a plain label with a mark) at angle 0, with its
+// edge and the centre spindle, which look the same at any angle. It is
+// rendered once per cover and size and then only rotated, by QPainter
+// (paintBeatJogImage()) or by the GPU (WSpinnyGLSL).
+void WSpinnyBase::updateBeatJogLabelImage(double pixelsPerUnit) {
+    const int sidePixels = qRound(2 * kLabelExtent * pixelsPerUnit);
+    const bool showCover = m_bShowCover && !m_loadedCover.isNull();
+    const qint64 key = (showCover ? m_loadedCover.cacheKey() : 0) ^
+            (static_cast<qint64>(sidePixels) << 48);
+    if (key == m_beatJogLabelKey && !m_beatJogLabelImage.isNull()) {
+        return;
+    }
+    m_beatJogLabelKey = key;
+    QImage image(sidePixels, sidePixels, QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+    QPainter p(&image);
+    p.setRenderHint(QPainter::Antialiasing);
+    p.setRenderHint(QPainter::SmoothPixmapTransform);
+    p.translate(sidePixels / 2.0, sidePixels / 2.0);
+    p.save();
+    QPainterPath label;
+    label.addEllipse(QPointF(0, 0), kLabelRadius * pixelsPerUnit, kLabelRadius * pixelsPerUnit);
+    p.setClipPath(label);
+    if (showCover) {
+        const int labelPixels = qRound(2 * kLabelRadius * pixelsPerUnit);
+        const QPixmap cover = m_loadedCover.scaled(labelPixels,
+                labelPixels,
+                Qt::KeepAspectRatioByExpanding,
+                Qt::SmoothTransformation);
+        p.drawPixmap(QPointF(-cover.width() / 2.0, -cover.height() / 2.0), cover);
+    }
+    p.restore();
+    p.scale(pixelsPerUnit, pixelsPerUnit);
+    if (!showCover) {
+        p.setPen(Qt::NoPen);
+        p.setBrush(QColor(0x2A, 0x2A, 0x2A));
+        p.drawEllipse(QPointF(0, 0), kLabelRadius, kLabelRadius);
+        QPen mark(withAlpha(Qt::white, 0.35));
+        mark.setWidthF(1.2);
+        mark.setCapStyle(Qt::RoundCap);
+        p.setPen(mark);
+        p.drawLine(QPointF(0, -kLabelRadius / 3), QPointF(0, -kLabelRadius * 0.86));
+    }
+    QPen labelEdge(withAlpha(Qt::black, 0.5));
+    labelEdge.setWidthF(0.6);
+    p.setPen(labelEdge);
+    p.setBrush(Qt::NoBrush);
+    p.drawEllipse(QPointF(0, 0), kLabelRadius, kLabelRadius);
+    p.setPen(Qt::NoPen);
+    p.setBrush(QColor(0xD7, 0xD7, 0xD7));
+    p.drawEllipse(QPointF(0, 0), 1.6, 1.6);
+    p.end();
+    m_beatJogLabelImage = image;
+}
