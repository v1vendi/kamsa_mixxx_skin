+void BeatJogShader::init() {
+    using namespace beatjog;
+    QString vertexShaderCode = QStringLiteral(R"--(
+attribute highp vec4 position;
+uniform highp vec4 toJog;
+varying highp vec2 vJog;
+void main()
+{
+    vJog = vec2(position.x * toJog.x + toJog.y, position.y * toJog.z + toJog.w);
+    gl_Position = position;
+}
+)--");
+
+    QString fragmentShaderCode = QStringLiteral(R"--(
+#ifdef GL_ES
+precision highp float;
+#endif
+)--");
+    fragmentShaderCode += define("TAU", kTau);
+    fragmentShaderCode += define("GROOVE_INNER", kGrooveInner);
+    fragmentShaderCode += define("GROOVE_OUTER", kGrooveOuter);
+    fragmentShaderCode += define("TICK_INNER", kTickInner);
+    fragmentShaderCode += define("TICK_OUTER", kTickOuter);
+    fragmentShaderCode += define("TICK_HALF_WIDTH", kTickWidth / 2);
+    fragmentShaderCode += define("LINE_HALF_WIDTH", kLineWidth / 2);
+    fragmentShaderCode += define("LINE_ALPHA", kLineAlpha);
+    fragmentShaderCode += define("LAMP_ANGLE", kLampAngle);
+    fragmentShaderCode += define("LAMP_X", std::cos(kLampAngle) * kLampRadius);
+    fragmentShaderCode += define("LAMP_Y", std::sin(kLampAngle) * kLampRadius);
+    fragmentShaderCode += define("LAMP_SPREAD", kLampSpread);
+    fragmentShaderCode += define("WASH_INNER", kWashInner);
+    fragmentShaderCode += define("WASH_OUTER", kWashOuter);
+    fragmentShaderCode += define("WASH_REACH", kWashReach);
+    fragmentShaderCode += define("WASH_ALPHA", kWashAlpha);
+    fragmentShaderCode += define("FIRST_ROW_DOTS", kStrobeRows[0]);
+    fragmentShaderCode += define("STROBE_OUTER", kStrobeOuter);
+    fragmentShaderCode += define("STROBE_ROW_PITCH", kStrobeRowPitch);
+    fragmentShaderCode += define("STROBE_DOT_HALF_WIDTH", kStrobeDotWidth / 2);
+    fragmentShaderCode += define("STROBE_BAND_HALF_ANGLE", kStrobeBandHalfAngle);
+    fragmentShaderCode += define("STROBE_BAND_ALPHA", kStrobeBandAlpha);
+    fragmentShaderCode += define("STROBE_MIN_ALPHA", kStrobeMinAlpha);
+    fragmentShaderCode += define("OUTER_LIMIT", kRimOuter + 1.0);
+    fragmentShaderCode += QStringLiteral(R"--(
+uniform highp float unitsPerPixel;
+uniform highp vec4 tickColor[4];
+uniform highp float lineAngle; // below -10: no position line
+uniform highp vec3 strobeColor;
+uniform highp float flicker; // 0: no strobe
+uniform highp float strobeBase[3];
+uniform highp float strobeBand[3];
+varying highp vec2 vJog;
+
+// coverage of a pixel whose centre is d jog units inside an edge
+float inside(float d) {
+    return clamp(d / unitsPerPixel + 0.5, 0.0, 1.0);
+}
+
+float wrapPi(float a) {
+    return a - TAU * floor(a / TAU + 0.5);
+}
+
+// premultiplied "source over"
+vec4 over(vec4 dst, vec3 rgb, float a) {
+    return vec4(rgb * a + dst.rgb * (1.0 - a), a + dst.a * (1.0 - a));
+}
+
+// coverage of a radial line at angle from radius r0 to r1
+float radialLine(vec2 p, float angle, float r0, float r1, float halfWidth, bool roundCaps) {
+    vec2 dir = vec2(cos(angle), sin(angle));
+    float along = dot(p, dir);
+    if (roundCaps) {
+        return inside(halfWidth - length(p - dir * clamp(along, r0, r1)));
+    }
+    float across = abs(dir.x * p.y - dir.y * p.x);
+    return inside(halfWidth - across) * inside(min(along - r0, r1 - along));
+}
+
+float lit(float angle) {
+    float x = wrapPi(angle - LAMP_ANGLE) / LAMP_SPREAD;
+    return min(1.0, 1.15 * exp(-x * x)) * flicker;
+}
+
+void main()
+{
+    vec2 p = vJog;
+    float r = length(p);
+    if (r > OUTER_LIMIT || r < GROOVE_INNER - 1.0) {
+        discard;
+    }
+    float theta = atan(p.y, p.x);
+    vec4 c = vec4(0.0);
+    for (int i = 0; i < 4; ++i) {
+        float a = TAU * (float(i) - 1.0) / 4.0;
+        c = over(c, tickColor[i].rgb,
+                tickColor[i].a * radialLine(p, a, TICK_INNER, TICK_OUTER, TICK_HALF_WIDTH, false));
+    }
+    if (flicker > 0.0) {
+        float band = inside(min(r - WASH_INNER, WASH_OUTER - r));
+        float fade = clamp(1.0 - distance(p, vec2(LAMP_X, LAMP_Y)) / WASH_REACH, 0.0, 1.0);
+        c = over(c, vec3(1.0, 120.0 / 255.0, 30.0 / 255.0), WASH_ALPHA * flicker * fade * band);
+        for (int row = 0; row < 3; ++row) {
+            float radius = STROBE_OUTER - STROBE_ROW_PITCH * (float(row) + 0.5);
+            float radial = inside(STROBE_DOT_HALF_WIDTH - abs(r - radius));
+            if (radial <= 0.0) {
+                continue;
+            }
+            if (strobeBand[row] > 0.5) {
+                float d = abs(wrapPi(theta - LAMP_ANGLE));
+                c = over(c, strobeColor,
+                        STROBE_BAND_ALPHA * radial * inside((STROBE_BAND_HALF_ANGLE - d) * radius));
+                continue;
+            }
