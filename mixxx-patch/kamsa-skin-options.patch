+            state.loaded = true;
+            const double playpos = std::clamp(m_dAngleCurrentPlaypos, 0.0, 1.0);
+            state.elapsedCentis = toCentis(playpos * duration);
+            state.remainCentis = toCentis((1.0 - playpos) * duration);
+            if (m_pEndOfTrack->get() > 0.0) {
+                state.warn = (m_blinkTimer.elapsed() / 500) % 2 ? 2 : 1;
+            }
+        }
+    }
+    const double bpm = m_pVisualBpm->get();
+    state.bpmTenths = bpm > 0 ? qRound(bpm * 10.0) : -1;
+    state.pitchTenths = qRound((m_pRateRatio->get() - 1.0) * 1000.0);
+    state.rangePercent = qRound(m_pRateRange->get() * 100.0);
+    state.cueLit = m_pCueIndicator && m_pCueIndicator->get() > 0;
+    state.cueHeld = m_cueHeldButton == Qt::LeftButton;
+    state.playLit = m_pPlayIndicator && m_pPlayIndicator->get() > 0;
+    state.syncOn = m_pSyncEnabled && m_pSyncEnabled->get() > 0;
+    state.leader = m_pSyncLeader ? qRound(m_pSyncLeader->get()) : 0;
