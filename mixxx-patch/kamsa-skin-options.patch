+// Strobe: a lamp window lighting dot rows on the platter edge.
+// BeatJogShader draws the same for WSpinnyGLSL.
+void WSpinnyBase::drawStrobe(QPainter* p) const {
+    const BeatJogFrame& frame = m_beatJogFrame;
+    const double flicker = frame.flicker;
+    const QPointF lamp = polar(kLampAngle, kLampRadius);
+    QRadialGradient wash(lamp, kWashReach);
+    wash.setColorAt(0.0, withAlpha(QColor(255, 120, 30), kWashAlpha * flicker));
+    wash.setColorAt(1.0, withAlpha(QColor(255, 120, 30), 0.0));
+    p->setPen(Qt::NoPen);
+    p->setBrush(wash);
+    p->drawPath(annulus(kWashInner, kWashOuter));
+    p->setBrush(Qt::NoBrush);
+
+    auto lit = [flicker](double angle) {
+        const double x = wrapPi(angle - kLampAngle) / kLampSpread;
+        return std::min(1.0, 1.15 * std::exp(-x * x)) * flicker;
+    };
+    // Qt arcs run counter-clockwise in 1/16 degrees.
+    auto toQt = [](double radians) {
+        return qRound(-radians * 180.0 / M_PI * 16.0);
+    };
+    QPen pen(m_strobeColor, kStrobeDotWidth);
+    pen.setCapStyle(Qt::FlatCap);
+    for (std::size_t row = 0; row < std::size(kStrobeRows); ++row) {
+        const int dots = kStrobeRows[row];
+        const double radius = strobeRowRadius(static_cast<int>(row));
+        const QRectF rect(-radius, -radius, 2 * radius, 2 * radius);
+        if (std::abs(frame.apparent[row]) > kStrobeBlur) {
+            pen.setColor(withAlpha(m_strobeColor, kStrobeBandAlpha));
+            p->setPen(pen);
+            p->drawArc(rect,
+                    toQt(kLampAngle - kStrobeBandHalfAngle),
+                    toQt(2 * kStrobeBandHalfAngle));
+            continue;
+        }
+        const double spacing = kTau / dots;
+        // the row's integrated apparent turn, not the platter angle
+        const double base = frame.strobePhase[row] * spacing - M_PI / 2;
+        const double half = spacing / 2;
+        for (int j = 0; j < dots; ++j) {
+            const double angle = base + j * spacing;
+            const double alpha = lit(angle + half / 2);
+            if (alpha < kStrobeMinAlpha) {
+                continue;
+            }
+            pen.setColor(withAlpha(m_strobeColor, alpha));
+            p->setPen(pen);
+            p->drawArc(rect, toQt(angle), toQt(half));
+        }
+    }
+}
