+void WSpinnyBase::drawDeckReadout(QPainter* p, const ReadoutState& state) {
+    const QFont base = font(); // skin font (stylesheet)
+    const QColor dimmed(0x6A, 0x6A, 0x6A);
+
+    // Title: wraps at word boundaries onto at most m_iTitleLines lines, the last
+    // one elided. Placement copies what a word-wrapping QLabel with AlignTop
+    // draws (qt_format_text: leading before every line).
+    if (!state.title.isEmpty()) {
+        const QFont f = boldFont(base, m_iTitleSize);
+        p->setFont(f);
+        const QFontMetricsF fm(f);
+        const qreal avail = width() - m_dReadoutRight - m_dTrackTextX;
+        QTextLayout layout(state.title, f);
+        QTextOption option;
+        option.setWrapMode(QTextOption::WordWrap);
+        layout.setTextOption(option);
+        layout.beginLayout();
+        QList<int> lineStarts;
+        for (QTextLine line = layout.createLine();
+                line.isValid() && lineStarts.size() < m_iTitleLines;
+                line = layout.createLine()) {
+            line.setLineWidth(avail);
+            lineStarts.append(line.textStart());
+        }
+        layout.endLayout();
+        const qreal lineStep = fm.leading() + fm.ascent() + fm.descent();
+        for (int i = 0; i < lineStarts.size(); ++i) {
+            const bool last = i == lineStarts.size() - 1;
+            const QString text = last
+                    ? state.title.mid(lineStarts[i])
+                    : state.title.mid(lineStarts[i], lineStarts[i + 1] - lineStarts[i]);
+            const qreal baseline = m_dTitleTop + i * lineStep + fm.leading() + fm.ascent();
+            drawHaloText(p,
+                    QPointF(m_dTrackTextX, baseline),
+                    fm.elidedText(text.trimmed(), Qt::ElideRight, avail),
+                    Qt::white);
+        }
+    }
+
+    // Boxed tempo: BPM in a white frame, "pitch  ±range" under it.
+    if (!m_tempoBox.isEmpty()) {
+        const QRectF box = m_tempoBox.adjusted(0.5, 0.5, -0.5, -0.5);
+        p->setPen(QPen(state.loaded ? QColor(0xF4, 0xF4, 0xF4) : QColor(0x4A, 0x4A, 0x4A), 1.0));
+        p->setBrush(QColor(0x11, 0x11, 0x11));
+        p->drawRoundedRect(box, 3, 3);
+        const QFont bpmFont = boldFont(base, qRound(box.height() * 0.5));
+        const QFont smallFont = boldFont(base, std::max(8, qRound(box.height() * 0.27)));
+        const QFontMetricsF bpmFm(bpmFont);
+        const QFontMetricsF smallFm(smallFont);
+        const double line1 = box.height() * 0.58;
+        const QString bpm = state.bpmTenths >= 0 ? formatTenths(state.bpmTenths)
+                                                 : QStringLiteral("--.-");
+        const QString pitch = (state.pitchTenths < 0
+                                              ? QStringLiteral("-")
+                                              : (state.pitchTenths > 0 ? QStringLiteral("+")
+                                                                       : QString())) +
+                formatTenths(std::abs(state.pitchTenths)) + QStringLiteral("%  ");
+        const QString range = QChar(0x00B1) + QString::number(state.rangePercent);
+        p->setFont(bpmFont);
+        p->setPen(state.loaded ? Qt::white : dimmed);
+        p->drawText(QPointF(box.center().x() - bpmFm.horizontalAdvance(bpm) / 2,
+                            lineBaseline(bpmFm, box.top() + 1, line1)),
+                bpm);
+        const double pitchWidth = smallFm.horizontalAdvance(pitch);
+        const double rangeWidth = smallFm.horizontalAdvance(range);
+        const double x = box.center().x() - (pitchWidth + rangeWidth) / 2;
+        const double baseline2 = lineBaseline(smallFm, box.top() + line1, box.height() - line1 - 2);
+        p->setFont(smallFont);
+        p->setPen(state.loaded ? QColor(0xCF, 0xCF, 0xCF) : dimmed);
+        p->drawText(QPointF(x, baseline2), pitch);
+        p->setPen(QColor(0xE0, 0x3C, 0x3C));
+        p->drawText(QPointF(x + pitchWidth, baseline2), range);
+        m_tempoRangeRect = QRectF(x + pitchWidth,
+                baseline2 - smallFm.ascent(),
+                rangeWidth,
+                smallFm.height());
+    }
+
+    // CUE and PLAY: 2 px rings like the skin's round buttons. CUE: warm tint while the
+    // deck sits on its cue point, filled while held. PLAY: green triangle, pause bars
+    // on a dark green tint while playing (play_indicator also blinks when cued).
+    const QColor buttonFill(0x1E, 0x1E, 0x1E);
+    if (m_pCueIndicator) {
+        const QColor orange(0xF2, 0xA4, 0x13);
+        p->setPen(QPen(orange, 2.0));
+        p->setBrush(state.cueHeld ? orange
+                                  : (state.cueLit ? QColor(0x3A, 0x2A, 0x08)
+                                                  : buttonFill));
+        p->drawEllipse(m_cueButton.adjusted(1, 1, -1, -1));
+        p->setFont(boldFont(base, 11));
+        p->setPen(state.cueHeld ? Qt::black : orange);
+        p->drawText(m_cueButton, Qt::AlignCenter, QStringLiteral("CUE"));
+    }
+    if (m_pPlayIndicator) {
+        const QColor green(0x2E, 0xCC, 0x55);
+        p->setPen(QPen(state.playLit ? QColor(0x5C, 0xF2, 0x83) : green, 2.0));
+        p->setBrush(state.playLit ? QColor(0x17, 0x4A, 0x26) : buttonFill);
+        p->drawEllipse(m_playButton.adjusted(1, 1, -1, -1));
+        // 16 px icon from the skin's 24-unit play / pause icons
+        p->save();
+        p->translate(m_playButton.center() - QPointF(8.0, 8.0));
+        p->scale(16.0 / 24.0, 16.0 / 24.0);
+        if (state.playLit) {
+            p->setPen(Qt::NoPen);
+            p->setBrush(QColor(0x7D, 0xFF, 0xA0));
+            p->drawRoundedRect(QRectF(6, 5, 4.2, 14), 0.8, 0.8);
+            p->drawRoundedRect(QRectF(13.8, 5, 4.2, 14), 0.8, 0.8);
+        } else {
+            QPen pen(green, 2.0);
+            pen.setJoinStyle(Qt::RoundJoin);
+            p->setPen(pen);
+            p->setBrush(green);
+            const QPointF triangle[] = {{8.5, 5}, {19.5, 12}, {8.5, 19}};
+            p->drawPolygon(triangle, 3);
+        }
+        p->restore();
+    }
+
+    // SYNC and M (leader) buttons. M: outline when this deck is the automatic
+    // (soft) leader, filled when it is the explicit leader.
+    if (m_pSyncEnabled) {
+        const QColor blue(0x0E, 0x76, 0xF1);
+        const QColor label(0xCF, 0xCF, 0xCF);
+        p->setFont(boldFont(base, 9));
+        p->setPen(Qt::NoPen);
+        p->setBrush(state.syncOn ? blue : QColor(0x26, 0x26, 0x26));
+        p->drawRoundedRect(m_syncRect, 2, 2);
+        p->setPen(state.syncOn ? Qt::white : label);
+        p->drawText(m_syncRect, Qt::AlignCenter, QStringLiteral("SYNC"));
+        p->setPen(QPen(state.leader > 0 ? blue : QColor(0x3A, 0x3A, 0x3A), 1.0));
+        p->setBrush(state.leader == 2 ? blue : QColor(0x1D, 0x1D, 0x1D));
+        p->drawRoundedRect(m_leaderRect.adjusted(0.5, 0.5, -0.5, -0.5), 2, 2);
+        p->setPen(state.leader == 2 ? Qt::white
+                                    : (state.leader == 1 ? QColor(0x5A, 0xA8, 0xFF) : label));
+        p->drawText(m_leaderRect, Qt::AlignCenter, QStringLiteral("M"));
+    }
+}
