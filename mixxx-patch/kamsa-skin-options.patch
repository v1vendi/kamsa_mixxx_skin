+void BpmControl::updateBarBeatPosition(mixxx::audio::FramePos playpos) {
+    constexpr int kBeatsPerBar = 4;
+    const mixxx::BeatsPointer pBeats = m_pBeats;
+    if (!pBeats || !playpos.isValid()) {
+        m_pBarBeatPosition->forceSet(0.0);
+        return;
+    }
+    auto it = pBeats->iteratorFrom(playpos);
+    if (it == pBeats->cend() || it == pBeats->cbegin()) {
+        m_pBarBeatPosition->forceSet(0.0);
+        return;
+    }
+    if (*it > playpos) {
+        --it; // the beat we are in, not the next one
+    }
+    const int beatIndex = it - pBeats->cfirstmarker();
+    // Floor division, so that beats before the first downbeat count down.
+    int barIndex = beatIndex / kBeatsPerBar;
+    int beatInBar = beatIndex % kBeatsPerBar + 1;
+    if (beatInBar <= 0) {
+        --barIndex;
+        beatInBar += kBeatsPerBar;
+    }
+    const int bar = barIndex >= 0 ? barIndex + 1 : barIndex;
+    // Encoded as bar.beat (bar is never 0); the sign belongs to the bar, so
+    // beat 2 of bar -1 is -1.2.
+    const double beatFraction = beatInBar / 10.0;
+    m_pBarBeatPosition->forceSet(bar > 0 ? bar + beatFraction : bar - beatFraction);
+}
