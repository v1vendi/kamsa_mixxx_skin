+static_assert(std::size(beatjog::kStrobeRows) == 3);
+static_assert(beatjog::kStrobeRows[1] == beatjog::kStrobeRows[0] + 1 &&
+                beatjog::kStrobeRows[2] == beatjog::kStrobeRows[0] + 2,
+        "the shader counts the dots of row i as kStrobeRows[0] + i");
