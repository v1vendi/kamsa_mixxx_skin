+// Beats since the first downbeat at the current play
+// position, and how fast that moves (m_dDeckBeatRate). False without a beatgrid.
+bool WSpinnyBase::updateDeckBeats(double dt, double* pDeckBeats) {
+    double deckBeats = 0.0;
+    const bool hasBeats = deckBeatsAt(m_dAngleCurrentPlaypos, &deckBeats);
+    if (!hasBeats) {
+        m_dDeckBeatRate = 0.0;
+    } else if (m_bDeckBeatsValid && dt > 0.0) {
+        const double delta = deckBeats - m_dDeckBeats;
+        if (std::abs(delta) > 2.0) {
+            m_dDeckBeatRate = 0.0; // seek or new track
+        } else {
+            m_dDeckBeatRate += (delta / dt - m_dDeckBeatRate) * std::min(1.0, dt / 0.08);
+        }
+    }
+    m_bDeckBeatsValid = hasBeats;
+    m_dDeckBeats = deckBeats;
+    *pDeckBeats = deckBeats;
+    return hasBeats;
+}
+
+// Strobe timing. The lamp flashes 25 times per reference beat. Each row's
+// apparent motion is how far its dots get past the nearest dot between two
+// flashes, integrated over the frame time. It comes from exact BPMs, not
+// from the jittery play position, so a matched row really stands still.
+// The reference is the file's own BPM, like a turntable strobe against the
+// mains: the 100-dot row stands still at 0 % pitch and any tempo change,
+// sync included, sets the dots moving.
+// Fills each row's apparent speed in dots per second (past kStrobeBlur it
+// smears into a band); false if there is no strobe to draw.
+bool WSpinnyBase::updateStrobe(bool hasBeats, bool moving, double dt, StrobeRowSpeeds* pApparent) {
+    static_assert(std::tuple_size_v<StrobeRowSpeeds> == std::size(kStrobeRows));
+    pApparent->fill(0.0);
+    const double refBpm = m_pFileBpm->get();
+    if (!hasBeats || !(refBpm > 0.0)) {
+        return false;
+    }
+    const double flashHz = kFlashesPerBeat * refBpm / 60.0;
+    // Playing normally the platter turns at exactly the deck BPM (the measured
+    // rate jumps with every audio buffer); scratched it turns at the measured rate.
+    double strobeRate = moving ? m_dDeckBeatRate : 0.0;
+    const double exactRate = m_pDeckBpm->get() / 60.0;
+    if (m_pPlay->get() > 0 && m_pStrobeScratch->get() <= 0 && exactRate > 0.0) {
+        strobeRate = m_pStrobeReverse->get() > 0 ? -exactRate : exactRate;
+    }
+    for (std::size_t row = 0; row < std::size(kStrobeRows); ++row) {
+        const double dots = kStrobeRows[row];
+        const double perFlash = dots * (strobeRate / 4.0) / flashHz;
+        (*pApparent)[row] = (perFlash - std::round(perFlash)) * flashHz;
+        m_strobePhase[row] = std::fmod(m_strobePhase[row] + (*pApparent)[row] * dt, dots);
+    }
+    return true;
+}
+
+bool WSpinnyBase::updateBeatJog() {
+    const double dpr = devicePixelRatioF();
+    const QSize pixelSize = size() * dpr;
+    if (pixelSize.isEmpty()) {
+        return false;
+    }
+    // The same pixel size at another DPR is another logical size (geometry).
+    if (m_beatJogBackground.size() != pixelSize ||
+            m_beatJogBackground.devicePixelRatio() != dpr) {
+        drawBeatJogBackground(pixelSize, dpr);
+    }
+
+    if (!m_beatJogTimer.isValid()) {
+        m_beatJogTimer.start();
+    }
+    const double now = m_beatJogTimer.nsecsElapsed() * 1e-9;
+    const double dt = m_dBeatJogLastTime < 0
+            ? 0.0
+            : std::clamp(now - m_dBeatJogLastTime, 0.0, 0.1);
+    m_dBeatJogLastTime = now;
+
+    // This deck: beats since the first downbeat, and how fast that moves.
+    double deckBeats = 0.0;
+    const bool hasBeats = updateDeckBeats(dt, &deckBeats);
+    const bool moving = std::abs(m_dDeckBeatRate) > 0.05;
+    StrobeRowSpeeds apparent;
+    const bool hasStrobe = updateStrobe(hasBeats, moving, dt, &apparent);
+
+    // While the platter stands still (paused, or no
+    // track loaded) the strobe lamp does not flicker and the dot rows do not
+    // move, so the frame only changes with these inputs. Skip the redraw and
+    // the texture upload when none of them changed.
+    const bool animating = moving || m_pPlay->get() > 0;
+    if (!hasStrobe || !animating) {
+        const BeatJogStaticKey key{{static_cast<double>(pixelSize.width()),
+                                           static_cast<double>(pixelSize.height()),
+                                           dpr,
+                                           hasBeats ? deckBeats : m_fAngle,
+                                           hasBeats ? 1.0 : 0.0,
+                                           hasStrobe ? 1.0 : 0.0,
+                                           m_bShowCover ? 1.0 : 0.0,
+                                           m_pLoadedTrack ? 1.0 : 0.0,
+                                           m_strobePhase[0],
+                                           m_strobePhase[1],
+                                           m_strobePhase[2]},
+                m_loadedCover.isNull() ? 0 : m_loadedCover.cacheKey(),
+                shouldDrawVinylQuality()};
+        if (m_beatJogStaticKey == key) {
+            return false;
+        }
+        m_beatJogStaticKey = key;
+    } else {
+        m_beatJogStaticKey.reset();
+    }
+
+    BeatJogFrame& frame = m_beatJogFrame;
+    frame.bar = hasBeats ? deckBeats / 4.0 : m_fAngle / 360.0;
+    frame.deckBeats = deckBeats;
+    frame.lightCurrentBeat = hasBeats && moving;
+    frame.hasStrobe = hasStrobe;
+    frame.hasTrack = m_pLoadedTrack != nullptr;
+    // steady lamp while the platter stands still
+    frame.flicker = hasStrobe && animating
+            ? 0.93 + 0.07 * QRandomGenerator::global()->generateDouble()
+            : 1.0;
+    frame.apparent = apparent;
+    std::copy(std::begin(m_strobePhase), std::end(m_strobePhase), frame.strobePhase.begin());
+
+    updateBeatJogLabelImage(beatJogScale() * dpr);
+    if (!beatJogOnGpu()) {
+        paintBeatJogImage(pixelSize, dpr);
+    }
+    return true;
+}
+
+void WSpinnyBase::paintBeatJogImage(const QSize& pixelSize, double dpr) {
+    const BeatJogFrame& frame = m_beatJogFrame;
+    // Reuse the frame buffer; the background overwrites all of it.
+    if (m_beatJogImage.size() != pixelSize) {
+        m_beatJogImage = QImage(pixelSize, QImage::Format_ARGB32_Premultiplied);
+    }
+    m_beatJogImage.setDevicePixelRatio(dpr);
+    QPainter p(&m_beatJogImage);
+    p.setCompositionMode(QPainter::CompositionMode_Source);
+    p.drawImage(QPointF(0, 0), m_beatJogBackground);
+    p.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    p.setRenderHint(QPainter::Antialiasing);
+    p.setRenderHint(QPainter::SmoothPixmapTransform);
+    p.translate(platterCenter());
+    const double k = beatJogScale();
+    p.scale(k, k);
+
+    drawBeatTicks(&p);
+    // the label image turning with the record
+    p.save();
+    p.rotate(frac(frame.bar) * 360.0);
+    p.drawImage(QRectF(-kLabelExtent, -kLabelExtent, 2 * kLabelExtent, 2 * kLabelExtent),
+            m_beatJogLabelImage);
+    p.restore();
+    if (frame.hasStrobe) {
+        drawStrobe(&p);
+    }
+
+    // Position line: this deck's place in the bar.
+    if (frame.hasTrack) {
+        QPen solid(withAlpha(Qt::white, kLineAlpha));
+        solid.setWidthF(kLineWidth);
+        solid.setCapStyle(Qt::RoundCap);
+        p.setPen(solid);
+        const double angle = beatJogLineAngle();
+        p.drawLine(polar(angle, kGrooveInner), polar(angle, kGrooveOuter));
+    }
+}
+
+double WSpinnyBase::beatJogLineAngle() const {
+    return frac(m_beatJogFrame.bar) * kTau - M_PI / 2;
+}
+
+// Beat ticks at 12, 3, 6 and 9 o'clock; the current beat lights up while
+// the deck moves. The downbeat is orange.
+std::array<QColor, 4> WSpinnyBase::beatTickColors() const {
+    const BeatJogFrame& frame = m_beatJogFrame;
+    const int beatInBar = static_cast<int>(std::floor(frame.deckBeats)) % 4;
+    const int currentBeat = beatInBar < 0 ? beatInBar + 4 : beatInBar;
+    const double inBeat = frac(frame.deckBeats);
+    std::array<QColor, 4> colors;
+    for (int beat = 0; beat < 4; ++beat) {
+        const QColor color = beat == 0 ? m_downbeatColor : QColor(235, 235, 235);
+        double alpha = beat == 0 ? 0.5 : 0.28;
+        if (frame.lightCurrentBeat && beat == currentBeat) {
+            alpha = 0.95 - 0.5 * inBeat;
+        }
+        colors[beat] = withAlpha(color, alpha);
+    }
+    return colors;
+}
+
+void WSpinnyBase::drawBeatTicks(QPainter* p) const {
+    const std::array<QColor, 4> colors = beatTickColors();
+    for (int beat = 0; beat < 4; ++beat) {
+        const double angle = -M_PI / 2 + beat * M_PI / 2;
+        QPen pen(colors[beat]);
+        pen.setWidthF(kTickWidth);
+        pen.setCapStyle(Qt::FlatCap);
+        p->setPen(pen);
+        p->drawLine(polar(angle, kTickInner), polar(angle, kTickOuter));
+    }
+}
