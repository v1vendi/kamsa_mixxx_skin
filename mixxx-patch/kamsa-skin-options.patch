+// Text with a soft dark halo, so it stays readable over the platter.
+void drawHaloText(QPainter* p, const QPointF& baseline, const QString& text, const QColor& color) {
+    static constexpr double kOffsets[][2] = {{-1.2, 0},
+            {1.2, 0},
+            {0, -1.2},
+            {0, 1.2},
+            {-0.9, -0.9},
+            {0.9, -0.9},
+            {-0.9, 0.9},
+            {0.9, 0.9},
+            {0, 1.6}};
+    p->setPen(QColor(0, 0, 0, 150));
+    for (const auto& offset : kOffsets) {
+        p->drawText(baseline + QPointF(offset[0], offset[1]), text);
+    }
+    p->setPen(color);
+    p->drawText(baseline, text);
+}
+
+// Baseline of a CSS-style line box of the given height starting at top.
+double lineBaseline(const QFontMetricsF& fm, double top, double lineHeight) {
+    return top + (lineHeight - (fm.ascent() + fm.descent())) / 2 + fm.ascent();
+}
+
+// "m:ss.cc"
+QString formatTime(int centis) {
+    return QStringLiteral("%1:%2.%3")
+            .arg(centis / 6000)
+            .arg((centis / 100) % 60, 2, 10, QChar('0'))
+            .arg(centis % 100, 2, 10, QChar('0'));
+}
+
+// "12.3"
+QString formatTenths(int tenths) {
+    return QStringLiteral("%1.%2").arg(tenths / 10).arg(tenths % 10);
+}
+
+QFont boldFont(QFont font, int pixelSize) {
+    font.setBold(true);
+    font.setPixelSize(pixelSize);
+    return font;
+}
