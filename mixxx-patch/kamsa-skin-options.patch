+bool WSpinnyBase::updateReadoutOverlay() {
+    if (!m_bDeckReadout) {
+        return false;
+    }
+    ReadoutState state = readoutState();
+    if (state.pixelSize.isEmpty()) {
+        return false; // nothing to paint into
+    }
+    if (state == m_readoutState && !m_readoutOverlay.isNull()) {
+        return false;
+    }
+    // Toggling back to the previous state (a blinking
+    // button) reuses its image instead of painting the overlay again.
+    if (state == m_prevReadoutState && !m_prevReadoutOverlay.isNull()) {
+        std::swap(m_readoutState, m_prevReadoutState);
+        std::swap(m_readoutOverlay, m_prevReadoutOverlay);
+        std::swap(m_readoutOverlayInfo, m_prevReadoutOverlayInfo);
+        return true;
+    }
+    m_prevReadoutState = std::move(m_readoutState);
+    m_prevReadoutOverlay = std::move(m_readoutOverlay);
+    m_prevReadoutOverlayInfo = m_readoutOverlayInfo;
+    m_readoutState = std::move(state);
+
+    // Repaint the static part only when it changed; while playing only the
+    // time lines change, so they are painted onto a copy of it.
+    ReadoutState staticState = m_readoutState;
+    staticState.elapsedCentis = 0;
+    staticState.remainCentis = 0;
+    staticState.warn = 0;
+    if (!(staticState == m_readoutStaticState) || m_readoutStaticOverlay.isNull()) {
+        QImage image(staticState.pixelSize, QImage::Format_ARGB32_Premultiplied);
+        image.fill(Qt::transparent);
+        image.setDevicePixelRatio(staticState.dpr);
+        QPainter p(&image);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setRenderHint(QPainter::TextAntialiasing);
+        drawDeckReadout(&p, staticState);
+        p.end();
+        m_readoutStaticOverlay = image;
+        m_readoutStaticState = std::move(staticState);
+    }
+    m_readoutOverlay = m_readoutStaticOverlay;
+    m_readoutOverlayInfo = ReadoutOverlayInfo{m_readoutStaticOverlay.cacheKey(), 0, 0};
+    if (m_readoutState.loaded) {
+        // QPainter detaches m_readoutOverlay from the static image.
+        QPainter p(&m_readoutOverlay);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setRenderHint(QPainter::TextAntialiasing);
+        const QRectF band = drawReadoutTime(&p, m_readoutState);
+        // The painted rows, in device pixels
+        if (!band.isEmpty()) {
+            const double dpr = m_readoutOverlay.devicePixelRatio();
+            m_readoutOverlayInfo.timeTop = std::clamp(
+                    static_cast<int>(std::floor(band.top() * dpr)),
+                    0,
+                    m_readoutOverlay.height());
+            m_readoutOverlayInfo.timeBottom = std::clamp(
+                    static_cast<int>(std::ceil(band.bottom() * dpr)),
+                    m_readoutOverlayInfo.timeTop,
+                    m_readoutOverlay.height());
+        }
+    }
