+/// Draws rekordbox-style cue markers over a rendered overview image:
+/// loops as translucent bands, hot cues as colored lines with a triangle
+/// at the top, and the main cue as a red triangle at the bottom.
+void drawCueMarkers(QImage* pImage, const QList<OverviewCache::CueMarker>& markers) {
+    const int width = pImage->width();
+    const int height = pImage->height();
+    if (markers.isEmpty() || width <= 0 || height <= 0) {
+        return;
+    }
+    const double lineWidth = std::max(1.0, height / 24.0);
+    const double marker = std::max(4.0, height * 0.3);
+
+    QPainter painter(pImage);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(Qt::NoPen); // Triangles are filled only
+
+    for (const auto& cue : markers) {
+        const double totalFrames = cue.totalFrames;
+        if (totalFrames <= 0 || cue.position < 0) {
+            continue;
+        }
+        const double x = width * std::clamp(cue.position / totalFrames, 0.0, 1.0);
+
+        switch (cue.type) {
+        case kCueTypeLoop: {
+            if (cue.length <= 0) {
+                break;
+            }
+            const double x2 = width *
+                    std::clamp((cue.position + cue.length) / totalFrames, 0.0, 1.0);
+            QColor band = cueColor(cue.color, kDefaultCueColor);
+            band.setAlpha(80);
+            painter.fillRect(QRectF(x, 0, std::max(lineWidth, x2 - x), height), band);
+            break;
+        }
+        case kCueTypeHotCue: {
+            const QColor color = cueColor(cue.color, kDefaultCueColor);
+            painter.fillRect(QRectF(x - lineWidth / 2, 0, lineWidth, height), color);
+            QPolygonF triangle;
+            triangle << QPointF(x - marker / 2, 0) << QPointF(x + marker / 2, 0)
+                     << QPointF(x, marker * 0.8);
+            painter.setBrush(color);
+            painter.drawPolygon(triangle);
+            break;
+        }
+        case kCueTypeMainCue: {
+            QPolygonF triangle;
+            triangle << QPointF(x - marker / 2, height) << QPointF(x + marker / 2, height)
+                     << QPointF(x, height - marker * 0.8);
+            painter.setBrush(kMainCueColor);
+            painter.drawPolygon(triangle);
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
