+/// Queries the inputs of drawCueMarkers(). Comparing them tells whether a
+/// cached overview must be re-rendered after the track has been saved.
+QList<OverviewCache::CueMarker> queryCueMarkers(
+        const QSqlDatabase& database, TrackId trackId) {
+    QList<OverviewCache::CueMarker> markers;
+    // Hot cues, main cue and loops, i.e. the kCueType* values above. Loops
+    // come first, so they are drawn below the cue markers.
+    static_assert(kCueTypeHotCue == 1 && kCueTypeMainCue == 2 && kCueTypeLoop == 4);
+    QSqlQuery query(database);
+    query.prepare(QStringLiteral(
+            "SELECT cues.type, cues.position, cues.length, cues.color, "
+            "library.duration, library.samplerate "
+            "FROM cues JOIN library ON library.id = cues.track_id "
+            "WHERE cues.track_id = :id AND cues.type IN (1, 2, 4) "
+            "ORDER BY cues.type DESC"));
+    query.bindValue(QStringLiteral(":id"), trackId.toVariant());
+    if (!query.exec()) {
+        kLogger.warning() << "Failed to query cues for" << trackId << query.lastError();
+        return markers;
+    }
+    while (query.next()) {
+        // cues.position/length are stored in engine samples (all channels),
+        // library.duration * samplerate is in frames.
+        markers.append(OverviewCache::CueMarker{
+                query.value(0).toInt(),
+                query.value(1).toDouble() / mixxx::kEngineChannelOutputCount,
+                query.value(2).toDouble() / mixxx::kEngineChannelOutputCount,
+                query.value(3).toLongLong(),
+                query.value(4).toDouble() * query.value(5).toDouble()});
+    }
+    return markers;
+}
