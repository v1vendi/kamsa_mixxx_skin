+void WSpinnyBase::drawBeatJogBackground(const QSize& pixelSize, double dpr) {
+    QImage image(pixelSize, QImage::Format_ARGB32_Premultiplied);
+    image.fill(m_beatJogFill.isValid() ? m_beatJogFill : QColor(Qt::transparent));
+    image.setDevicePixelRatio(dpr);
+    QPainter p(&image);
+    p.setRenderHint(QPainter::Antialiasing);
+    p.translate(platterCenter());
+    const double k = beatJogScale();
+    p.scale(k, k);
+
+    p.setPen(Qt::NoPen);
+    p.setBrush(QColor(0x0B, 0x0B, 0x0B));
+    p.drawEllipse(QPointF(0, 0), kPlatterRadius, kPlatterRadius);
+    // the strobe rim of the platter
+    p.setBrush(QColor(0x16, 0x16, 0x16));
+    p.drawPath(annulus(kRimInner, kRimOuter));
+    // grooves
+    p.setBrush(Qt::NoBrush);
+    for (double r = kGrooveInner; r < kGrooveOuter; r += 0.9) {
+        const double s = std::sin(r * 3.1);
+        QPen pen(withAlpha(Qt::white, 0.06 * (0.6 + 0.4 * s * s)));
+        pen.setWidthF(0.35);
+        p.setPen(pen);
+        p.drawEllipse(QPointF(0, 0), r, r);
+    }
+    // fixed light reflection on the vinyl
+    QConicalGradient sheen(0, 0, 45.0);
+    sheen.setColorAt(0.0, withAlpha(Qt::white, 0.0));
+    sheen.setColorAt(0.05, withAlpha(Qt::white, 0.12));
+    sheen.setColorAt(0.10, withAlpha(Qt::white, 0.0));
+    sheen.setColorAt(0.50, withAlpha(Qt::white, 0.0));
+    sheen.setColorAt(0.55, withAlpha(Qt::white, 0.085));
+    sheen.setColorAt(0.60, withAlpha(Qt::white, 0.0));
+    sheen.setColorAt(1.0, withAlpha(Qt::white, 0.0));
+    p.setPen(Qt::NoPen);
+    p.setBrush(sheen);
+    p.drawPath(annulus(kLabelRadius + 1.0, kRimInner));
+    QPen edge(QColor(0x3A, 0x3A, 0x3A));
+    edge.setWidthF(0.8);
+    p.setPen(edge);
+    p.setBrush(Qt::NoBrush);
+    p.drawEllipse(QPointF(0, 0), 54.6, 54.6);
+    p.end();
+    m_beatJogBackground = image;
+}
