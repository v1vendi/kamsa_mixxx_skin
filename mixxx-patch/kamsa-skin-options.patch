+                kMargin;
+        const double bandBottom =
+                std::max(elBaseline + elFm.descent(), remBaseline + remFm.descent()) +
+                kMargin;
+        return QRectF(0, bandTop, width(), bandBottom - bandTop);
+    }
+    return QRectF();
